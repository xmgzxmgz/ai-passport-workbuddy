#!/bin/zsh
# wbctl —— WBBridge 服务的命令行开关
#
#   wbctl start     启动服务（等价于双击 WBBridge.app）
#   wbctl stop      停止服务
#   wbctl restart   重启
#   wbctl status    看进程 / 端口 / 工牌连接状态
#   wbctl log       实时看日志
#   wbctl send "文字"  [会话id]   走同一条链路发一条文本（诊断）
#   wbctl route [会话id]          看当前路由到的网关实例
#
# 安装：cp wbctl /usr/local/bin/wbctl && chmod +x /usr/local/bin/wbctl
set -u

APP="${WB_APP:-/Applications/WBBridge.app}"
[[ -d "$APP" ]] || APP="$HOME/Applications/WBBridge.app"
WB_HOME_DIR="${WB_HOME:-$HOME/.workbuddy}"
LOG="$WB_HOME_DIR/wb_bridge.log"
PIDFILE="$WB_HOME_DIR/wb_bridge.pid"
PORT="${WB_HTTP_PORT:-8765}"

pid() {
  local p
  if [[ -f "$PIDFILE" ]]; then
    p="$(cat "$PIDFILE" 2>/dev/null)"
    [[ -n "$p" ]] && ps -p "$p" -o command= 2>/dev/null | grep -q wb_bridge.py && { echo "$p"; return 0; }
  fi
  p="$(/usr/sbin/lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1)"
  [[ -n "$p" ]] && { echo "$p"; return 0; }
  return 1
}

api() { curl -s --max-time "${2:-30}" "http://127.0.0.1:$PORT$1"; }

case "${1:-status}" in
  start)
    if p="$(pid)"; then echo "已在运行 (pid $p)"; exit 0; fi
    [[ -d "$APP" ]] || { echo "找不到 $APP（用 WB_APP 指定路径）"; exit 1; }
    open -a "$APP" && echo "已启动 $APP"
    ;;
  stop)
    if p="$(pid)"; then
      kill "$p" 2>/dev/null
      for i in {1..25}; do kill -0 "$p" 2>/dev/null || break; sleep 0.2; done
      kill -0 "$p" 2>/dev/null && kill -9 "$p"
      rm -f "$PIDFILE"
      echo "已停止 (pid $p)"
    else
      echo "未在运行"
    fi
    ;;
  restart)
    "$0" stop; sleep 1; "$0" start
    ;;
  status)
    if p="$(pid)"; then
      echo "进程   : 运行中 (pid $p)"
    else
      echo "进程   : 未运行"; exit 1
    fi
    echo "端口   : $(/usr/sbin/lsof -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | tail -1 | awk '{print $1" "$9}')"
    echo "日志   : $LOG"
    if s="$(api /ble 5 2>/dev/null)"; then
      echo "$s" | python3 -c 'import json,sys
d=json.load(sys.stdin)
if d.get("connected"):
    print("工牌   : 已连接 %s (MTU %s, 收 %s 字节)" % (d.get("peer"), d.get("mtu"), d.get("received")))
else:
    print("工牌   : 未连接 (%s)" % (d.get("error") or "等待广播"))' 2>/dev/null
      echo "对话   : $(api /conversations 10 | python3 -c 'import json,sys;d=json.load(sys.stdin);print(len(d.get("items",[])),"条")' 2>/dev/null)"
    fi
    ;;
  log)
    tail -f "$LOG"
    ;;
  send)
    TEXT="${2:-ping}"; CONV="${3:-}"
    curl -s -G --max-time 300 "http://127.0.0.1:$PORT/send" \
      --data-urlencode "text=$TEXT" ${CONV:+--data-urlencode "conv=$CONV"}
    echo
    ;;
  route)
    SID="${2:-}"
    curl -s --max-time 30 "http://127.0.0.1:$PORT/route?sid=$SID" | python3 -m json.tool 2>/dev/null || \
      api "/route?sid=$SID"
    ;;
  *)
    echo "用法: wbctl {start|stop|restart|status|log|send|route}"
    exit 1
    ;;
esac
