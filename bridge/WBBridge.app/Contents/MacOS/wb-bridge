#!/bin/zsh
# ---------------------------------------------------------------------------
# WBBridge.app 启动器
#
# 真正的服务逻辑在 ../Resources/bridge/wb_bridge.py（打包后）
# 或 ../../../wb_bridge.py（源码目录里直接 open 时的开发模式）。
#
# 为什么要套一层 .app：macOS 的蓝牙权限（TCC）按"应用"授权，裸 python
# 解释器没有 NSBluetoothAlwaysUsageDescription，一碰 CoreBluetooth 就被
# SIGKILL（exit 137）。壳里声明了用途说明，授权才记得住。
#
# 设计要点
#   1. 代码目录按 bundle 相对路径解析，不写死绝对路径 —— 拖到 /Applications
#      或用 DMG 直接挂载运行都能跑。
#   2. Python 解释器按顺序探测（WB_PYTHON > bundle 内 venv > 托管 venv >
#      Homebrew > 系统），逐个验证能否 import bleak/numpy，选第一个可用的。
#   3. 录音与端口缓存重定向到 ~/.workbuddy，代码目录只读也能工作。
#   4. 单实例：已在跑就弹窗给出「停止 / 重启 / 好」，不会起第二个抢 BLE。
#   5. 启动自检：子进程 6 秒内死掉就弹告警，并可直接打开日志。
# ---------------------------------------------------------------------------
set -u

APP_NAME="WBBridge"
WB_HOME_DIR="${WB_HOME:-$HOME/.workbuddy}"
LOG="$WB_HOME_DIR/wb_bridge.log"
PIDFILE="$WB_HOME_DIR/wb_bridge.pid"
PORT="${WB_HTTP_PORT:-8765}"

HERE="${0:A:h}"                        # .../WBBridge.app/Contents/MacOS
RES="$(dirname "$HERE")/Resources"

if [[ -d "$RES/bridge" ]]; then
  BRIDGE_DIR="$RES/bridge"
  PACKAGED=1
else
  # 源码布局：bridge/WBBridge.app/Contents/MacOS/wb-bridge
  BRIDGE_DIR="${HERE:A:h:h:h}"
  PACKAGED=0
fi

mkdir -p "$WB_HOME_DIR" "$WB_HOME_DIR/voice_out"

# 日志超过 8MB 截断，避免无界增长
if [[ -f "$LOG" ]] && (( $(stat -f%z "$LOG" 2>/dev/null || echo 0) > 8388608 )); then
  tail -n 4000 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
fi

log() { echo "=== $(date '+%F %T') [launcher] $* ===" >>"$LOG"; }

alert() {  # alert <标题> <正文>
  /usr/bin/osascript -e "display alert \"$1\" message \"$2\" as warning buttons {\"好\"} default button \"好\"" >/dev/null 2>&1
}

# --- 已经在跑？ -------------------------------------------------------------
running_pid() {
  local p
  if [[ -f "$PIDFILE" ]]; then
    p="$(cat "$PIDFILE" 2>/dev/null)"
    if [[ -n "$p" ]] && ps -p "$p" -o command= 2>/dev/null | grep -q "wb_bridge.py"; then
      echo "$p"; return 0
    fi
  fi
  p="$(/usr/sbin/lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1)"
  if [[ -n "$p" ]]; then echo "$p"; return 0; fi
  return 1
}

stop_pid() {  # stop_pid <pid>
  local p="$1"
  kill "$p" 2>/dev/null
  local i=0
  while (( i < 50 )) && kill -0 "$p" 2>/dev/null; do sleep 0.2; i=$((i+1)); done
  kill -0 "$p" 2>/dev/null && kill -9 "$p" 2>/dev/null
  rm -f "$PIDFILE"
}

if p="$(running_pid)"; then
  log "already running pid=$p"
  CHOICE="$(/usr/bin/osascript -e 'button returned of (display alert "WBBridge 已在运行" message "服务进程 PID 见下，端口 8765。工牌连上后会显示在菜单栏通知里。\n\n要停止还是重启？" as informational buttons {"好","停止服务","重启"} default button "好")' 2>/dev/null)"
  case "$CHOICE" in
    停止服务)
      stop_pid "$p"; log "stopped by user pid=$p"
      ;;
    重启)
      stop_pid "$p"; sleep 1
      /usr/bin/open -a "$(cd "$HERE/../.." && pwd)" 2>/dev/null || /usr/bin/open "$(cd "$HERE/../.." && pwd)"
      ;;
  esac
  exit 0
fi

# --- 选 Python --------------------------------------------------------------
pick_python() {
  local candidates=()
  [[ -n "${WB_PYTHON:-}" ]] && candidates+=("$WB_PYTHON")
  candidates+=(
    "$RES/venv/bin/python3"
    "$WB_HOME_DIR/binaries/python/envs/default/bin/python"
    "$HOME/.workbuddy/binaries/python/envs/default/bin/python"
    "/opt/homebrew/bin/python3"
    "/usr/local/bin/python3"
    "/usr/bin/python3"
  )
  local py
  for py in "${candidates[@]}"; do
    [[ -x "$py" ]] || continue
    if "$py" -c 'import bleak, numpy' >/dev/null 2>&1; then
      echo "$py"; return 0
    fi
  done
  return 1
}

PY="$(pick_python)" || PY=""
if [[ -z "$PY" ]]; then
  log "no python with bleak/numpy found"
  alert "WBBridge 无法启动" "没有找到装有 bleak / numpy 的 Python。\n\n请先在终端执行：\n  pip3 install -r \"$BRIDGE_DIR/requirements.txt\"\n或用 WB_PYTHON 指定解释器路径。"
  exit 1
fi

cd "$BRIDGE_DIR" || { alert "WBBridge 无法启动" "代码目录不存在：$BRIDGE_DIR"; exit 1; }

export PYTHONUNBUFFERED=1
export WB_VOICE_DIR="${WB_VOICE_DIR:-$WB_HOME_DIR/voice_out}"
export WB_GW_CACHE="${WB_GW_CACHE:-$WB_HOME_DIR/.gw_cache.json}"
export WB_HOME="${WB_HOME:-$WB_HOME_DIR}"

log "start packaged=$PACKAGED py=$PY dir=$BRIDGE_DIR"

"$PY" -u wb_bridge.py >>"$LOG" 2>&1 &
CHILD=$!
echo "$CHILD" >"$PIDFILE"

# 启动自检：活着就提示一句，6 秒内死了就弹告警 + 一键看日志
(
  sleep 6
  if kill -0 "$CHILD" 2>/dev/null; then
    /usr/bin/osascript -e 'display notification "服务已启动，等待工牌连接" with title "WBBridge"' >/dev/null 2>&1
  else
    CHOICE="$(/usr/bin/osascript -e 'button returned of (display alert "WBBridge 启动失败" message "服务进程启动后很快就退出了。\n\n常见原因：Python 依赖缺失、蓝牙未授权、8765 端口被占用。\n日志：'"$LOG"'" as critical buttons {"好","打开日志"} default button "打开日志")' 2>/dev/null)"
    [[ "$CHOICE" == "打开日志" ]] && /usr/bin/open -e "$LOG"
  fi
) &

cleanup() { rm -f "$PIDFILE"; }
trap cleanup EXIT
trap 'kill "$CHILD" 2>/dev/null; exit 0' TERM INT

wait "$CHILD"
CODE=$?
log "service exited code=$CODE"
exit $CODE
